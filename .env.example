APP_NAME=EcoModular
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite works for evaluation. Production: MySQL 8 (InnoDB, utf8mb4).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ecomodular
# DB_USERNAME=ecomodular
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production over HTTPS: set to true.
SESSION_SECURE_COOKIE=false

# Seconds a password confirmation stays valid for sensitive admin areas (users, roles).
AUTH_PASSWORD_TIMEOUT=1800

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe keys are entered in Admin > Payments > Stripe and stored encrypted; never put them here.
# Minutes before an unpaid Stripe Checkout session expires and the order is cancelled (30-1440).
STRIPE_SESSION_TTL_MINUTES=30

# Security headers (see docs/installation/production.md).
ECOMODULAR_CSP=enforce
ECOMODULAR_CSP_IMG_SOURCES=
ECOMODULAR_HSTS=true

# Installer: set to false after installing with php artisan ecomodular:install.
ECOMODULAR_WEB_INSTALLER=true
ECOMODULAR_INSTALLER_TOKEN_HOURS=24

# Monitoring: bearer token that unlocks per-check details on /health.
ECOMODULAR_HEALTH_TOKEN=

# Backups (php artisan ecomodular:backup). Set a password to AES-256 encrypt archives.
ECOMODULAR_BACKUP_PASSWORD=
ECOMODULAR_BACKUP_KEEP=7
ECOMODULAR_BACKUP_SCHEDULE=02:30

# Official marketplace (client, every store). See docs/marketplace/licensing.md.
ECOMODULAR_MARKETPLACE_URL=https://marketplace.ecomodular.dev
# Comma-separated Ed25519 public keys trusted for release signatures.
ECOMODULAR_MARKETPLACE_TRUSTED_KEYS=
ECOMODULAR_MARKETPLACE_GRACE_DAYS=14

# Marketplace server (the platform owner's marketplace instance only).
ECOMODULAR_MARKETPLACE_SERVER=false
# Secret key from `php artisan ecomodular:marketplace:keygen`. Never commit it.
ECOMODULAR_MARKETPLACE_SIGNING_KEY=
MARKETPLACE_STRIPE_SECRET=
MARKETPLACE_STRIPE_WEBHOOK_SECRET=
