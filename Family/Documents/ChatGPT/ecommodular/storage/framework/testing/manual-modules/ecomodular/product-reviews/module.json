{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "ecomodular/product-reviews",
    "display_name": "Product Reviews",
    "description": "Customers rate and review products; staff moderate reviews before they appear.",
    "version": "1.1.0",
    "type": "module",
    "platform_version": "^0.4 || ^1.0",
    "author": "Eleydo",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\ProductReviews\\": "src/"
        }
    },
    "provider": "EcoModular\\ProductReviews\\ProductReviewsServiceProvider",
    "permissions": [
        {
            "name": "reviews.moderate",
            "label": "Moderate product reviews",
            "group": "Reviews"
        }
    ],
    "capabilities": [
        "admin.routes",
        "admin.navigation",
        "storefront.routes",
        "storefront.slots",
        "database.migrations",
        "settings",
        "permissions"
    ],
    "migrations": "database/migrations",
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages",
        "slots": "resources/js/slots"
    },
    "settings": [
        {
            "key": "auto_approve",
            "type": "boolean",
            "label": "Publish reviews without moderation",
            "help": "When off, new reviews wait for a staff member to approve them.",
            "default": false
        },
        {
            "key": "require_purchase",
            "type": "boolean",
            "label": "Only customers who bought the product can review it",
            "default": false
        },
        {
            "key": "min_length",
            "type": "integer",
            "label": "Minimum review length (characters)",
            "default": 10,
            "min": 0,
            "max": 500
        }
    ],
    "admin_navigation": [
        {
            "key": "reviews",
            "title": "Reviews",
            "route": "index",
            "icon": "star",
            "group": "Catalog",
            "permission": "reviews.moderate",
            "order": 140
        }
    ]
}
