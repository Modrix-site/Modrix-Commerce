{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/eleydo/ecomodular/docs/extensions/theme.schema.json",
    "title": "EcoModular theme manifest",
    "description": "theme.json of an EcoModular theme. Themes are data only. The platform validator (App\\Core\\Themes\\ThemeManifestValidator) is authoritative and additionally checks files, paths and section settings.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "display_name",
        "version",
        "type",
        "theme_type",
        "platform_version"
    ],
    "properties": {
        "$schema": { "type": "string" },
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$"
        },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "type": { "const": "theme" },
        "theme_type": { "const": "storefront" },
        "platform_version": { "type": "string", "maxLength": 100 },
        "author": { "type": "string", "maxLength": 120 },
        "license": { "type": "string", "maxLength": 60 },
        "requires": {
            "type": "object",
            "additionalProperties": { "type": "string" }
        },
        "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "home.sections",
                    "custom_fonts",
                    "dark_mode",
                    "demo_content"
                ]
            }
        },
        "assets": { "$ref": "#/$defs/relativePath" },
        "screenshot": { "$ref": "#/$defs/relativePath" },
        "design": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "color.background": { "$ref": "#/$defs/color" },
                "color.foreground": { "$ref": "#/$defs/color" },
                "color.primary": { "$ref": "#/$defs/color" },
                "color.primary_foreground": { "$ref": "#/$defs/color" },
                "color.muted": { "$ref": "#/$defs/color" },
                "color.muted_foreground": { "$ref": "#/$defs/color" },
                "color.accent": { "$ref": "#/$defs/color" },
                "color.accent_foreground": { "$ref": "#/$defs/color" },
                "color.border": { "$ref": "#/$defs/color" },
                "font_body": { "$ref": "#/$defs/font" },
                "font_heading": { "$ref": "#/$defs/font" },
                "radius": {
                    "enum": [
                        "0",
                        "0.25rem",
                        "0.375rem",
                        "0.5rem",
                        "0.625rem",
                        "0.75rem",
                        "1rem",
                        "1.5rem"
                    ]
                },
                "density": { "enum": ["compact", "comfortable", "spacious"] },
                "container": { "enum": ["narrow", "default", "wide"] },
                "layout.header": { "enum": ["classic", "centered", "minimal"] },
                "layout.footer": { "enum": ["simple", "columns"] },
                "layout.product_card": {
                    "enum": ["standard", "minimal", "framed"]
                },
                "layout.grid_columns": { "enum": ["3", "4"] },
                "layout.product_page": { "enum": ["split", "stacked"] },
                "logo": { "$ref": "#/$defs/image" },
                "favicon": { "$ref": "#/$defs/image" },
                "announcement": { "type": "string", "maxLength": 160 },
                "footer_text": { "type": "string", "maxLength": 500 },
                "style.general.heading_font": {"$ref": "#/$defs/font"},
                "style.general.heading_size": {"enum": ["20", "24", "28", "32", "36", "40", "48", "56", "64"]},
                "style.general.heading_weight": {"enum": ["400", "500", "600", "700", "800"]},
                "style.general.heading_color": {"$ref": "#/$defs/color"},
                "style.general.body_font": {"$ref": "#/$defs/font"},
                "style.general.body_size": {"enum": ["13", "14", "15", "16", "17", "18"]},
                "style.general.body_color": {"$ref": "#/$defs/color"},
                "style.general.button_bg": {"$ref": "#/$defs/color"},
                "style.general.button_text": {"$ref": "#/$defs/color"},
                "style.general.button_hover_bg": {"$ref": "#/$defs/color"},
                "style.general.button_font": {"$ref": "#/$defs/font"},
                "style.general.button_size": {"enum": ["12", "13", "14", "15", "16", "18"]},
                "style.general.button_radius": {"enum": ["0", "0.25rem", "0.375rem", "0.5rem", "0.625rem", "0.75rem", "1rem", "1.5rem"]},
                "style.general.price_size": {"enum": ["14", "16", "18", "20", "24", "28"]},
                "style.general.price_color": {"$ref": "#/$defs/color"},
                "style.general.price_sale_color": {"$ref": "#/$defs/color"},
                "style.home.heading_font": {"$ref": "#/$defs/font"},
                "style.home.heading_size": {"enum": ["20", "24", "28", "32", "36", "40", "48", "56", "64"]},
                "style.home.heading_weight": {"enum": ["400", "500", "600", "700", "800"]},
                "style.home.heading_color": {"$ref": "#/$defs/color"},
                "style.home.body_font": {"$ref": "#/$defs/font"},
                "style.home.body_size": {"enum": ["13", "14", "15", "16", "17", "18"]},
                "style.home.body_color": {"$ref": "#/$defs/color"},
                "style.home.button_bg": {"$ref": "#/$defs/color"},
                "style.home.button_text": {"$ref": "#/$defs/color"},
                "style.home.button_hover_bg": {"$ref": "#/$defs/color"},
                "style.home.button_font": {"$ref": "#/$defs/font"},
                "style.home.button_size": {"enum": ["12", "13", "14", "15", "16", "18"]},
                "style.home.button_radius": {"enum": ["0", "0.25rem", "0.375rem", "0.5rem", "0.625rem", "0.75rem", "1rem", "1.5rem"]},
                "style.home.price_size": {"enum": ["14", "16", "18", "20", "24", "28"]},
                "style.home.price_color": {"$ref": "#/$defs/color"},
                "style.home.price_sale_color": {"$ref": "#/$defs/color"},
                "style.catalog.heading_font": {"$ref": "#/$defs/font"},
                "style.catalog.heading_size": {"enum": ["20", "24", "28", "32", "36", "40", "48", "56", "64"]},
                "style.catalog.heading_weight": {"enum": ["400", "500", "600", "700", "800"]},
                "style.catalog.heading_color": {"$ref": "#/$defs/color"},
                "style.catalog.body_font": {"$ref": "#/$defs/font"},
                "style.catalog.body_size": {"enum": ["13", "14", "15", "16", "17", "18"]},
                "style.catalog.body_color": {"$ref": "#/$defs/color"},
                "style.catalog.button_bg": {"$ref": "#/$defs/color"},
                "style.catalog.button_text": {"$ref": "#/$defs/color"},
                "style.catalog.button_hover_bg": {"$ref": "#/$defs/color"},
                "style.catalog.button_font": {"$ref": "#/$defs/font"},
                "style.catalog.button_size": {"enum": ["12", "13", "14", "15", "16", "18"]},
                "style.catalog.button_radius": {"enum": ["0", "0.25rem", "0.375rem", "0.5rem", "0.625rem", "0.75rem", "1rem", "1.5rem"]},
                "style.catalog.price_size": {"enum": ["14", "16", "18", "20", "24", "28"]},
                "style.catalog.price_color": {"$ref": "#/$defs/color"},
                "style.catalog.price_sale_color": {"$ref": "#/$defs/color"},
                "style.product.heading_font": {"$ref": "#/$defs/font"},
                "style.product.heading_size": {"enum": ["20", "24", "28", "32", "36", "40", "48", "56", "64"]},
                "style.product.heading_weight": {"enum": ["400", "500", "600", "700", "800"]},
                "style.product.heading_color": {"$ref": "#/$defs/color"},
                "style.product.body_font": {"$ref": "#/$defs/font"},
                "style.product.body_size": {"enum": ["13", "14", "15", "16", "17", "18"]},
                "style.product.body_color": {"$ref": "#/$defs/color"},
                "style.product.button_bg": {"$ref": "#/$defs/color"},
                "style.product.button_text": {"$ref": "#/$defs/color"},
                "style.product.button_hover_bg": {"$ref": "#/$defs/color"},
                "style.product.button_font": {"$ref": "#/$defs/font"},
                "style.product.button_size": {"enum": ["12", "13", "14", "15", "16", "18"]},
                "style.product.button_radius": {"enum": ["0", "0.25rem", "0.375rem", "0.5rem", "0.625rem", "0.75rem", "1rem", "1.5rem"]},
                "style.product.price_size": {"enum": ["14", "16", "18", "20", "24", "28"]},
                "style.product.price_color": {"$ref": "#/$defs/color"},
                "style.product.price_sale_color": {"$ref": "#/$defs/color"},
                "style.cart.heading_font": {"$ref": "#/$defs/font"},
                "style.cart.heading_size": {"enum": ["20", "24", "28", "32", "36", "40", "48", "56", "64"]},
                "style.cart.heading_weight": {"enum": ["400", "500", "600", "700", "800"]},
                "style.cart.heading_color": {"$ref": "#/$defs/color"},
                "style.cart.body_font": {"$ref": "#/$defs/font"},
                "style.cart.body_size": {"enum": ["13", "14", "15", "16", "17", "18"]},
                "style.cart.body_color": {"$ref": "#/$defs/color"},
                "style.cart.button_bg": {"$ref": "#/$defs/color"},
                "style.cart.button_text": {"$ref": "#/$defs/color"},
                "style.cart.button_hover_bg": {"$ref": "#/$defs/color"},
                "style.cart.button_font": {"$ref": "#/$defs/font"},
                "style.cart.button_size": {"enum": ["12", "13", "14", "15", "16", "18"]},
                "style.cart.button_radius": {"enum": ["0", "0.25rem", "0.375rem", "0.5rem", "0.625rem", "0.75rem", "1rem", "1.5rem"]},
                "style.cart.price_size": {"enum": ["14", "16", "18", "20", "24", "28"]},
                "style.cart.price_color": {"$ref": "#/$defs/color"},
                "style.cart.price_sale_color": {"$ref": "#/$defs/color"},
                "header.logo_height": {"type": "integer", "minimum": 24, "maximum": 96},
                "header.background": {"$ref": "#/$defs/color"},
                "header.text": {"$ref": "#/$defs/color"},
                "header.search": {"enum": ["bar", "icon"]},
                "header.menu_align": {"enum": ["left", "center", "right"]},
                "header.cart_icon": {"enum": ["bag", "cart"]},
                "header.cart_count": {"type": "boolean"},
                "header.account_link": {"type": "boolean"},
                "catalog.columns_desktop": {"enum": ["2", "3", "4", "5"]},
                "catalog.columns_mobile": {"enum": ["1", "2"]},
                "catalog.per_page": {"type": "integer", "minimum": 12, "maximum": 48},
                "catalog.default_sort": {"enum": ["newest", "price_asc", "price_desc", "name"]},
                "catalog.filters": {"type": "boolean"},
                "catalog.image_ratio": {"enum": ["square", "portrait", "landscape"]},
                "catalog.hover_image": {"type": "boolean"},
                "catalog.quick_add": {"type": "boolean"},
                "catalog.badges": {"type": "boolean"},
                "catalog.show_brand": {"type": "boolean"},
                "product.thumbnails": {"enum": ["side", "bottom"]},
                "product.zoom": {"type": "boolean"},
                "product.show_sku": {"type": "boolean"},
                "product.stock_note": {"enum": ["off", "low", "always"]},
                "product.description": {"enum": ["open", "tabs", "accordion"]},
                "product.related": {"type": "boolean"},
                "product.related_count": {"type": "integer", "minimum": 2, "maximum": 12},
                "product.upsells": {"type": "boolean"},
                "product.quantity": {"type": "boolean"},
                "cart.free_shipping_bar": {"type": "boolean"},
                "cart.cross_sells": {"type": "boolean"},
                "cart.coupon": {"type": "boolean"},
                "cart.trust_badges": {"type": "boolean"},
                "cart.continue_link": {"type": "boolean"},
                "checkout.summary_side": {"enum": ["right", "left"]},
                "checkout.sticky_summary": {"type": "boolean"},
                "checkout.company": {"type": "boolean"},
                "checkout.address_line2": {"type": "boolean"},
                "checkout.phone": {"enum": ["hidden", "optional", "required"]},
                "checkout.order_note": {"type": "boolean"},
                "checkout.terms": {"type": "boolean"},
                "checkout.trust_badges": {"type": "boolean"},
                "checkout.heading": {"type": "string", "maxLength": 60},
                "checkout.button_label": {"type": "string", "maxLength": 40},
                "checkout.summary_images": {"type": "boolean"},
                "checkout.coupon": {"type": "boolean"}
            }
        },
        "dark_colors": {
            "type": "object",
            "propertyNames": {
                "enum": [
                    "background",
                    "foreground",
                    "primary",
                    "primary_foreground",
                    "muted",
                    "muted_foreground",
                    "accent",
                    "accent_foreground",
                    "border"
                ]
            },
            "additionalProperties": { "$ref": "#/$defs/color" }
        },
        "fonts": {
            "type": "array",
            "maxItems": 6,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "file"],
                "properties": {
                    "family": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9 ]{0,39}$"
                    },
                    "file": { "$ref": "#/$defs/relativePath" },
                    "weight": {
                        "type": "string",
                        "pattern": "^\\d{3}( \\d{3})?$"
                    },
                    "style": { "enum": ["normal", "italic"] }
                }
            }
        },
        "sections": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "home": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                        "type": "object",
                        "required": ["type"],
                        "properties": {
                            "type": {
                                "enum": [
                                    "hero",
                                    "featured_products",
                                    "category_grid",
                                    "image_with_text",
                                    "rich_text",
                                    "promo_banner"
                                ]
                            },
                            "settings": { "type": "object" }
                        }
                    }
                }
            }
        },
        "demo_content": { "$ref": "#/$defs/relativePath" },
        "changelog": {
            "type": "array",
            "maxItems": 50,
            "items": {
                "type": "object",
                "required": ["version", "date", "notes"],
                "properties": {
                    "version": { "type": "string" },
                    "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "notes": { "type": "string", "maxLength": 500 }
                }
            }
        }
    },
    "$defs": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "font": {
            "anyOf": [
                {
                    "enum": [
                        "sans",
                        "system",
                        "humanist",
                        "geometric",
                        "rounded",
                        "serif",
                        "didone",
                        "mono"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^custom:[A-Za-z][A-Za-z0-9 ]{0,39}$"
                }
            ]
        },
        "image": {
            "type": "string",
            "pattern": "^(|asset:.+\\.(png|jpe?g|webp))$"
        },
        "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "not": {
                "pattern": "(^[/\\\\])|(^[a-zA-Z]:)|(^|[/\\\\])\\.\\.([/\\\\]|$)"
            }
        }
    }
}
