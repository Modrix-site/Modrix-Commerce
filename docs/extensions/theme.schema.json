{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/eleydo/ecomodular/docs/extensions/theme.schema.json",
    "title": "EcoModular theme manifest",
    "description": "theme.json of an EcoModular theme. Themes are data only. The platform validator (App\\Core\\Themes\\ThemeManifestValidator) is authoritative and additionally checks files, paths and section settings.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "display_name",
        "version",
        "type",
        "theme_type",
        "platform_version"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?/[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$"
        },
        "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
        },
        "description": {
            "type": "string",
            "maxLength": 500
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "type": {
            "const": "theme"
        },
        "theme_type": {
            "const": "storefront"
        },
        "platform_version": {
            "type": "string",
            "maxLength": 100
        },
        "author": {
            "type": "string",
            "maxLength": 120
        },
        "license": {
            "type": "string",
            "maxLength": 60
        },
        "requires": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "home.sections",
                    "custom_fonts",
                    "dark_mode",
                    "demo_content"
                ]
            }
        },
        "assets": {
            "$ref": "#/$defs/relativePath"
        },
        "screenshot": {
            "$ref": "#/$defs/relativePath"
        },
        "design": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "color.background": {
                    "$ref": "#/$defs/color"
                },
                "color.foreground": {
                    "$ref": "#/$defs/color"
                },
                "color.primary": {
                    "$ref": "#/$defs/color"
                },
                "color.primary_foreground": {
