                    "type": "string"
                },
                "menu_8_link": {
                    "type": "string"
                },
                "menu_9_label": {
                    "type": "string"
                },
                "menu_9_link": {
                    "type": "string"
                },
                "menu_10_label": {
                    "type": "string"
                },
                "menu_10_link": {
                    "type": "string"
                },
                "menu_11_label": {
                    "type": "string"
                },
                "menu_11_link": {
                    "type": "string"
                },
                "menu_12_label": {
                    "type": "string"
                },
                "menu_12_link": {
                    "type": "string"
                }
            }
        },
        "dark_colors": {
            "type": "object",
            "propertyNames": {
                "enum": [
                    "background",
                    "foreground",
                    "primary",
                    "primary_foreground",
                    "muted",
                    "muted_foreground",
                    "accent",
                    "accent_foreground",
                    "border"
                ]
            },
            "additionalProperties": {
                "$ref": "#/$defs/color"
            }
        },
        "fonts": {
            "type": "array",
            "maxItems": 6,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "family",
                    "file"
                ],
                "properties": {
                    "family": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9 ]{0,39}$"
                    },
                    "file": {
                        "$ref": "#/$defs/relativePath"
                    },
                    "weight": {
                        "type": "string",
                        "pattern": "^\\d{3}( \\d{3})?$"
                    },
                    "style": {
                        "enum": [
                            "normal",
                            "italic"
                        ]
                    }
                }
            }
        },
        "sections": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "home": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                        "type": "object",
                        "required": [
                            "type"
                        ],
                        "properties": {
                            "type": {
                                "enum": [
                                    "hero",
                                    "featured_products",
                                    "category_grid",
                                    "image_with_text",
                                    "rich_text",
                                    "promo_banner",
                                    "campaign",
                                    "promotion_grid"
                                ]
                            },
                            "settings": {
                                "type": "object"
                            }
                        }
                    }
                }
            }
        },
        "demo_content": {
            "$ref": "#/$defs/relativePath"
        },
        "changelog": {
            "type": "array",
            "maxItems": 50,
            "items": {
                "type": "object",
                "required": [
                    "version",
                    "date",
                    "notes"
                ],
                "properties": {
                    "version": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "notes": {
                        "type": "string",
                        "maxLength": 500
                    }
                }
            }
        },
        "customizer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "title": {
                    "type": "string",
                    "maxLength": 120
                },
                "description": {
                    "type": "string",
                    "maxLength": 500
                },
                "hide_core_fields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "fields": {
                    "type": "object",
                    "maxProperties": 120,
                    "additionalProperties": {
                        "$ref": "#/$defs/customizerField"
                    }
                },
                "presets": {
                    "type": "object",
                    "maxProperties": 12,
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": {
                            "$ref": "#/$defs/designValue"
                        }
                    }
                }
            }
        },
        "frontend": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "index": {
                    "const": "src/index.tsx"
                },
                "catalog": {
                    "const": "src/catalog.tsx"
                },
                "stylesheet": {
                    "const": "src/style.css"
                },
                "cart": {
                    "const": "src/cart.tsx"
                },
                "header": {
                    "const": "src/header.tsx"
                },
                "footer": {
                    "const": "src/footer.tsx"
                },
                "product": {
                    "const": "src/product.tsx"
                }
            }
        },
        "customizer_file": {
            "$ref": "#/$defs/relativePath"
        }
    },
    "$defs": {
        "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "font": {
            "anyOf": [
                {
                    "enum": [
                        "sans",
                        "system",
                        "humanist",
                        "geometric",
                        "rounded",
                        "serif",
                        "didone",
                        "mono"
                    ]
                },
                {
                    "type": "string",
                    "pattern": "^custom:[A-Za-z][A-Za-z0-9 ]{0,39}$"
                }
            ]
        },
        "image": {
            "type": "string",
            "pattern": "^(|asset:.+\\.(png|jpe?g|webp))$"
        },
        "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "not": {
                "pattern": "(^[/\\\\])|(^[a-zA-Z]:)|(^|[/\\\\])\\.\\.([/\\\\]|$)"
            }
        },
        "customizerField": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "type",
                "label",
                "default"
            ],
            "properties": {
                "type": {
                    "enum": [
                        "string",
                        "text",
                        "color",
                        "boolean",
                        "integer",
                        "select",
                        "link",
                        "image",
                        "font"
                    ]
                },
                "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                },
                "group": {
                    "type": "string",
                    "maxLength": 100
                },
                "default": {
                    "$ref": "#/$defs/designValue"
                },
                "options": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                        "type": "string"
                    }
                },
                "min": {
                    "type": "integer",
                    "minimum": -100000,
                    "maximum": 100000
                },
                "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                },
                "required": {
                    "type": "boolean"
                }
            }
        },
        "designValue": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "integer"
                },
                {
                    "type": "boolean"
                }
            ]
        }
    }
}
