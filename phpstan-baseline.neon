		-
			message: '#^Parameter \#1 \$state of method App\\Core\\Localization\\ContentTranslations\:\:putState\(\) expects array\{editor\: array\<string, array\<string, string\>\>, stored\: array\<string, array\<string, string\>\>, budget\: int\|null, deadline\: float\|null, attempted\: array\<string, true\>\}, non\-empty\-array given\.$#'
			identifier: argument.type
