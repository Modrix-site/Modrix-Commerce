			count: 1
			path: app/Core/Content/RichText.php

		-
			message: '#^Parameter \#1 \$value of function collect expects Illuminate\\Contracts\\Support\\Arrayable\<int\<0, max\>, string\>\|iterable\<int\<0, max\>, string\>\|null, non\-empty\-list\<string\>\|false given\.$#'
			identifier: argument.type
			count: 1
			path: app/Core/Content/RichText.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
