{
    "$schema": "../../../docs/extensions/module.schema.json",
    "name": "ecomodular/checkout-com",
    "display_name": "Checkout.com",
    "description": "Accept cards and local payment methods with Checkout.com. Customers pay on Checkout.com's hosted page, or in Flow embedded on your checkout. Card details never reach this store.",
    "version": "1.0.0",
    "type": "module",
    "icon": "credit-card",
    "accent": "#0c1b33",
    "platform_version": "^1.0",
    "author": "Eleydo",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EcoModular\\CheckoutCom\\": "src/"
        }
    },
    "provider": "EcoModular\\CheckoutCom\\CheckoutComServiceProvider",
    "capabilities": [
        "payment.gateway",
        "storefront.routes",
        "admin.routes",
        "admin.navigation",
        "content_security"
    ],
    "routes": {
        "admin": "routes/admin.php",
        "storefront": "routes/storefront.php"
    },
    "assets": {
        "pages": "resources/js/pages"
    },
    "content_security": {
        "script-src": [
            "https://checkout-web-components.checkout.com",
            "https://cdn.checkout.com",
            "https://js.checkout.com"
        ],
        "frame-src": [
            "https://checkout-web-components.checkout.com",
            "https://pay.checkout.com",
            "https://pay.sandbox.checkout.com"
        ],
        "connect-src": [
            "https://api.checkout.com",
            "https://api.sandbox.checkout.com",
            "https://checkout-web-components.checkout.com"
        ],
        "form-action": [
            "https://pay.checkout.com",
            "https://pay.sandbox.checkout.com",
            "https://api.checkout.com",
            "https://api.sandbox.checkout.com"
        ]
    },
    "admin_navigation": [
        {
            "key": "checkout-com",
            "title": "Checkout.com",
            "route": "index",
            "icon": "credit-card",
            "group": "Configuration",
            "permission": "payments.manage",
            "order": 864
        }
    ]
}
