includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        # Bundled first-party modules are held to the same standard.
        - modules/

    level: 7

    # The baseline may differ slightly between the PHP versions CI runs.
    reportUnmatchedIgnoredErrors: false
