{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "ecomodular/noir",
    "display_name": "Noir",
    "description": "A dark, high-contrast luxury theme with gold accents and fashion typography, for jewelry, accessories and premium goods.",
    "version": "1.0.2",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^0.4 || ^1.0",
    "author": "Eleydo",
    "license": "MIT",
    "capabilities": ["home.sections", "demo_content"],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "design": {
        "color.background": "#0e0e10",
        "color.foreground": "#f4f1ea",
        "color.primary": "#d6b16a",
        "color.primary_foreground": "#111111",
        "color.muted": "#19191c",
        "color.muted_foreground": "#a6a29a",
        "color.accent": "#26231e",
        "color.accent_foreground": "#f4f1ea",
        "color.border": "#2c2c31",
        "font_body": "geometric",
        "font_heading": "didone",
        "radius": "0",
        "density": "spacious",
        "container": "wide",
        "layout.header": "centered",
        "layout.footer": "columns",
        "layout.product_card": "minimal",
        "layout.grid_columns": "3",
        "layout.product_page": "stacked",
        "announcement": "Complimentary gift wrapping on every order",
        "footer_text": "Objects made to be kept. Designed in small batches."
    },
    "sections": {
        "home": [
            {
                "type": "hero",
                "settings": {
                    "heading": "Quiet luxury, made to last",
                    "subheading": "Pieces in gold and black, designed in small batches.",
                    "button_label": "Discover the collection",
                    "button_link": "/search",
                    "image": "asset:assets/images/hero.webp",
                    "alignment": "left",
                    "height": "large"
                }
            },
            {
                "type": "promo_banner",
                "settings": {
                    "text": "New season: the gold edit is here.",
                    "button_label": "Shop the edit",
                    "button_link": "/search?sort=newest",
                    "tone": "accent"
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "The latest pieces",
                    "source": "latest",
                    "limit": 6
                }
            },
            {
                "type": "image_with_text",
                "settings": {
                    "heading": "From our atelier",
                    "body": "Every piece is designed and finished by hand, then checked twice before it leaves us. Small batches mean less waste and more care.",
                    "image": "asset:assets/images/atelier.webp",
                    "image_position": "right",
                    "button_label": "Our craft",
                    "button_link": "/search"
                }
            },
            {
                "type": "category_grid",
                "settings": {
                    "title": "Collections",
                    "limit": 6
                }
            },
            {
                "type": "rich_text",
                "settings": {
                    "heading": "Made to be kept",
                    "body": "Free repairs for the life of every piece.",
                    "alignment": "center"
                }
            }
        ]
    },
    "demo_content": "demo.json",
    "changelog": [
        {
            "version": "1.0.0",
            "date": "2026-10-16",
            "notes": "First release."
        }
    ],
    "customizer_file": "settings.json"
}
