{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "ecomodular/essence",
    "display_name": "Essence",
    "description": "The free default theme: clean, neutral and fast, with a calm grid that lets products speak.",
    "version": "1.0.2",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^0.4 || ^1.0",
    "author": "Eleydo",
    "license": "MIT",
    "capabilities": ["home.sections", "dark_mode"],
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#171717",
        "color.primary": "#171717",
        "color.primary_foreground": "#fafafa",
        "color.muted": "#f5f5f5",
        "color.muted_foreground": "#6b6b6b",
        "color.accent": "#f2f2f0",
        "color.accent_foreground": "#171717",
        "color.border": "#e5e5e5",
        "font_body": "sans",
        "font_heading": "sans",
        "radius": "0.625rem",
        "density": "comfortable",
        "container": "default",
        "layout.header": "classic",
        "layout.footer": "columns",
        "layout.product_card": "standard",
        "layout.grid_columns": "4",
        "layout.product_page": "split"
    },
    "dark_colors": {
        "background": "#0f0f0f",
        "foreground": "#f5f5f5",
        "primary": "#f5f5f5",
        "primary_foreground": "#171717",
        "muted": "#1f1f1f",
        "muted_foreground": "#a3a3a3",
        "accent": "#262626",
        "accent_foreground": "#f5f5f5",
        "border": "#2e2e2e"
    },
    "sections": {
        "home": [
            {
                "type": "hero",
                "settings": {
                    "heading": "Thoughtfully made, simply sold",
                    "subheading": "Browse the latest arrivals or shop by category.",
                    "button_label": "Shop all products",
                    "button_link": "/search",
                    "alignment": "left",
                    "height": "medium"
                }
            },
            {
                "type": "category_grid",
                "settings": {
                    "title": "Shop by category",
                    "limit": 6
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "New arrivals",
                    "source": "latest",
                    "limit": 8
                }
            }
        ]
    },
    "changelog": [
        {
            "version": "1.0.0",
            "date": "2026-10-16",
            "notes": "First release."
        }
    ],
    "screenshot": "assets/demo-preview.png",
    "assets": "assets",
    "customizer_file": "settings.json"
}
