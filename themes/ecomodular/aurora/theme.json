{
    "$schema": "../../../docs/extensions/theme.schema.json",
    "name": "ecomodular/aurora",
    "display_name": "Aurora",
    "description": "A crisp, modern theme with cool aurora accents, generous whitespace and clean product cards, for technology, lifestyle and design-led brands. Ships three ready-made palettes.",
    "version": "1.0.1",
    "type": "theme",
    "theme_type": "storefront",
    "platform_version": "^1.0",
    "author": "Eleydo",
    "license": "MIT",
    "capabilities": ["home.sections", "dark_mode", "demo_content"],
    "assets": "assets",
    "screenshot": "assets/demo-preview.png",
    "design": {
        "color.background": "#ffffff",
        "color.foreground": "#0f172a",
        "color.primary": "#0d9488",
        "color.primary_foreground": "#ffffff",
        "color.muted": "#f1f5f9",
        "color.muted_foreground": "#64748b",
        "color.accent": "#e2f6f4",
        "color.accent_foreground": "#0f172a",
        "color.border": "#e2e8f0",
        "color.search": "#0d9488",
        "color.sale": "#e11d48",
        "font_body": "sans",
        "font_heading": "sans",
        "radius": "0.75rem",
        "density": "comfortable",
        "container": "default",
        "layout.header": "classic",
        "layout.footer": "columns",
        "layout.product_card": "standard",
        "layout.grid_columns": "4",
        "layout.product_page": "split",
        "announcement": "Free carbon-neutral delivery on every order",
        "footer_text": "Thoughtful objects for everyday life.",
        "contact_email": "hello@example.com",
        "help_link": "/account",
        "menu_1_label": "New in",
        "menu_1_link": "/search",
        "menu_2_label": "Audio",
        "menu_2_link": "/search?q=audio",
        "menu_3_label": "Wearables",
        "menu_3_link": "/search?q=watch",
        "menu_4_label": "Accessories",
        "menu_4_link": "/search?q=bag",
        "footer_1_title": "Shop",
        "footer_1_1_label": "New arrivals",
        "footer_1_1_link": "/search",
        "footer_1_2_label": "Best sellers",
        "footer_1_2_link": "/search",
        "footer_1_3_label": "Gift cards",
        "footer_1_3_link": "/search",
        "footer_2_title": "Help",
        "footer_2_1_label": "Your account",
        "footer_2_1_link": "/account",
        "footer_2_2_label": "Track your order",
        "footer_2_2_link": "/account/orders",
        "footer_2_3_label": "Shipping and returns",
        "footer_2_3_link": "/search",
        "footer_3_title": "About",
        "footer_3_1_label": "Our story",
        "footer_3_1_link": "/account",
        "footer_3_2_label": "Sustainability",
        "footer_3_2_link": "/account",
        "footer_3_3_label": "Contact us",
        "footer_3_3_link": "/account"
    },
    "dark_colors": {
        "background": "#0b1120",
        "foreground": "#e2e8f0",
        "primary": "#2dd4bf",
        "primary_foreground": "#04211f",
        "muted": "#111c30",
        "muted_foreground": "#94a3b8",
        "accent": "#13283a",
        "accent_foreground": "#e2e8f0",
        "border": "#1e293b"
    },
    "sections": {
        "home": [
            {
                "type": "hero",
                "settings": {
                    "heading": "Everyday objects, beautifully made",
                    "subheading": "Audio, wearables and essentials designed to last, with materials you can feel good about.",
                    "button_label": "Shop new arrivals",
                    "button_link": "/search",
                    "image": "asset:assets/images/hero.webp",
                    "alignment": "left",
                    "height": "large"
                }
            },
            {
                "type": "featured_products",
                "settings": {
                    "title": "New in",
                    "source": "latest",
                    "limit": 8
                }
            },
            {
                "type": "category_grid",
                "settings": {
                    "title": "Shop by category",
                    "limit": 6
                }
            },
            {
                "type": "image_with_text",
                "settings": {
                    "heading": "Made slowly, priced fairly",
                    "body": "We work with small workshops and hold fewer, better things. Each product is tested for months before it reaches you, and every part is repairable.",
                    "image": "asset:assets/images/studio.webp",
                    "image_position": "right",
                    "button_label": "Our approach",
                    "button_link": "/search"
                }
            },
            {
                "type": "promo_banner",
                "settings": {
                    "text": "Join the list and get 10% off your first order.",
                    "button_label": "Create an account",
                    "button_link": "/register",
                    "tone": "accent"
                }
            }
        ]
    },
    "demo_content": "demo.json",
    "changelog": [
        {
            "version": "1.0.0",
            "date": "2026-10-14",
            "notes": "First release. Aurora palette presets: aurora, slate and ember."
        }
    ],
    "customizer_file": "settings.json"
}
