APP_NAME="Modrix Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://marketplace.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Marketplace database (independent of every merchant store).
# SQLite (small installs):
DB_CONNECTION=sqlite
DB_DATABASE=database/marketplace.sqlite
# MySQL / MariaDB (typical hosting):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketplace
# DB_USERNAME=marketplace
# DB_PASSWORD=

# Shared hosting friendly: everything in the database.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

MARKETPLACE_CURRENCY=USD
# Private files (package ZIPs, releases, uploads). Default: storage/app/private
# MARKETPLACE_STORAGE=

# Source tree with modules/ and themes/ for `php artisan marketplace:publish`.
# Default: the folder above this app (the platform repository).
CATALOG_ROOT=
