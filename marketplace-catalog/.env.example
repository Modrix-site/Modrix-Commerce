APP_NAME="Modrix Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Marketplace database. This file is independent of every merchant store.
DB_CONNECTION=sqlite
DB_DATABASE=storage/catalog.sqlite

# Directory scanned for themes and extensions when this app is deployed
# beside the platform. On a separate server, point this at the package source.
CATALOG_ROOT=
# Uploads, the database directory, and built package archives.
CATALOG_STORAGE=storage

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
